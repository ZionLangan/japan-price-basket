{
  "policy_version": "1.2",
  "updated_at": "2026-10-10",
  "primary_source": "Statistics Bureau Retail Price Survey Trend Survey",
  "ingestion_start_month": "2000-01",
  "default_gap_mode": "allow_reviewed_estimates",
  "temporary_gap": {
    "max_anchor_age_calendar_months": 2,
    "requires_reviewed_missing_reason": true
  },
  "reviewed_market_gap": {
    "max_anchor_age_calendar_months": 2,
    "allowed_tokens": ["-"],
    "requires_explicit_owner_authorized_short_gap_assumption": true,
    "raw_token_remains_unavailable": true,
    "claim_precise_historical_missing_reason": false,
    "requires_product_missing_price_estimate_rule": true,
    "allow_approved_equivalent_segments": true,
    "anchor_native_quote_used_for_calculation": true
  },
  "seasonal_gap": {
    "enabled": true,
    "max_anchor_age_calendar_months": 11,
    "requires_effective_dated_survey_calendar": true,
    "requires_anchor_in_preceding_survey_season": true,
    "allow_approved_equivalent_segments": true,
    "requires_dated_calendars_for_all_intervening_months": true,
    "known_unsurveyed_tokens_may_identify_off_season": ["..", "...", "…"],
    "off_season_token_inference_requires_actual_published_city_cell": true,
    "off_season_token_inference_allowed_in_scheduled_months": false,
    "preserve_original_unsurveyed_token": true,
    "allowed_only_in_scheduled_off_season": true,
    "stop_when_new_season_complete_month_is_published": true
  },
  "carry_forward": {
    "anchor_must_be_actual_observation": true,
    "require_same_city_scope": true,
    "require_same_specification_segment": false,
    "require_reviewed_continuity_when_segment_changes": true,
    "require_active_segment_for_every_intervening_month": true,
    "use_anchor_native_quote_and_conversion": true,
    "require_complete_published_month": true,
    "allow_before_first_observation": false,
    "allow_after_discontinuation": false,
    "allow_chained_estimates": false,
    "allow_city_or_product_substitution": false
  },
  "comparison": {
    "require_fixed_city_variants_and_quantities": true,
    "require_reviewed_continuity_between_endpoints": true,
    "allow_estimated_endpoints_with_explicit_label": true,
    "allow_replacement_variant_bridge": false,
    "allow_reviewed_minor_definition_changes": true,
    "require_positive_baseline_cost": true
  },
  "generic_food_history": {
    "authorized_by": "Owner request on 2026-10-10: prioritize long-term food price trends, permit modest definition changes, quantity conversion and disclosed seasonal smoothing",
    "target": "All officially published food histories from January 2000 through the latest complete month in all actual surveyed city scopes wherever evidence permits",
    "reviewable_continuity": [
      "Wording, punctuation and spelling changes",
      "Supported quantity and package-size conversions",
      "Modest brand, grade or size changes within the same generic kind of food"
    ],
    "retain_dated_original_definitions": true,
    "quantity_conversion_requires_documented_factor": true,
    "estimated_conversion_requires_explicit_label": true,
    "unknown_package_weight_midpoints_allowed": false,
    "unreviewed_species_recipe_or_product_form_replacement_allowed": false,
    "quality_adjusted_inflation_claim_allowed": false,
    "seasonally_adjusted_series_claim_allowed": false
  },
  "source_caption_conflicts": {
    "require_explicit_dated_review": true,
    "retain_original_caption_and_price": true,
    "review_evidence": [
      "Official dated basic specification",
      "Official specification change register where applicable",
      "Adjacent original source observations"
    ],
    "native_numeric_price_remains_observed": true,
    "uncertain_derived_quantity_cost_is_estimated": true,
    "uncertainty_survives_observed_only_mode": true,
    "uncertainty_marker": "Identity factor 1 within kg or L; the reviewed quote quantity supplies the divisor",
    "unreviewed_conflicts_allowed": false,
    "reviewed_uncertainty_windows": [
      { "code": "1011", "start": "2002-01", "end": "2002-01" },
      { "code": "1331", "start": "2000-01", "end": "2000-01" },
      { "code": "1331", "start": "2000-03", "end": "2000-03" },
      { "code": "1331", "start": "2005-05", "end": "2005-10" },
      { "code": "2042", "start": "2000-01", "end": "2006-12" }
    ],
    "review_document": "FOOD_QUANTITY_RECONCILIATION.md"
  },
  "unresolved_source_periods": {
    "retain_raw_staging_evidence": true,
    "exclude_from_reviewed_publication": true,
    "require_explicit_code_and_bounded_period": true,
    "require_dated_basic_definition_to_be_absent": true,
    "overlapping_approval_or_exclusion_allowed": false,
    "unknown_future_period_exclusion_allowed": false,
    "current_codes": ["1061", "1121", "1122", "1291", "1439", "1440"],
    "current_start": "2000-09",
    "current_end": "2007-06",
    "current_reason": "Unresolved local basic definition"
  },
  "point_statuses": [
    "observed",
    "estimated_temporary",
    "estimated_seasonal",
    "unavailable",
    "pending",
    "estimated_quantity_conversion"
  ],
  "basket_statuses": ["observed", "estimated", "unavailable"],
  "unavailable_price_value": null,
  "decimal_wire_format": "string",
  "search_fields": [
    "name_en",
    "name_ja",
    "reviewed_aliases",
    "reviewed_readings",
    "family",
    "category",
    "form",
    "specification_terms",
    "explicit_source_brands",
    "official_item_code"
  ],
  "normalization": ["NFKC", "English case folding", "whitespace normalization"],
  "catalog_admission_requires_resolved_local_specifications": true,
  "source_prices_overwritten_by_estimates": false,
  "public_catalog": {
    "require_complete_usable_selected_city_period": true,
    "require_reviewed_comparison_continuity": true,
    "guard_changes_that_invalidate_current_basket": true,
    "excluded_source_codes": ["4431", "4441"]
  },
  "product_exceptions": {
    "mixed-size-eggs": {
      "authorized_by": "Owner request on 2026-10-10: estimated conversion in main basket and generic egg history",
      "comparison_basis": "Generic egg count; original size definitions remain visible, not quality-adjusted CPI",
      "historical_quantity_conversion": {
        "start": "2000-01",
        "end": "2002-06",
        "from": "count",
        "to": "kg",
        "factor": "0.06",
        "estimated": true,
        "basis": "Source specification: approximately 60 g per whole egg",
        "source_url": "https://www.stat.go.jp/data/kouri/doukou/zuhyou/200001.xls"
      },
      "missing_price_estimate": {
        "tokens": ["-"],
        "max_anchor_age_calendar_months": 2,
        "allow_approved_equivalent_segments": true,
        "anchor_quote_used_for_calculation": true,
        "estimated": true,
        "allow_before_first_observation": false,
        "allow_chaining": false
      },
      "observed_only": "Exclude missing-price carry; retain explicitly estimated quantity conversion of actual observed kg prices"
    },
    "canned-sweet-corn": {
      "source_code": "1491",
      "comparison_basis": "Drained kernels, excluding liquid",
      "source_url": "https://www.stat.go.jp/info/today/127.htm",
      "historical_quoted_solids_kg": [
        { "start": "2000-01", "end": "2002-06", "quantity": "0.275" },
        { "start": "2002-07", "end": "2003-12", "quantity": "0.145" },
        { "start": "2004-01", "end": "2014-08", "quantity": "0.13" },
        { "start": "2014-09", "end": "2026-08", "quantity": "1" }
      ],
      "per_kg_quote_after_reporting_change": true,
      "gross_contents_used_as_drained_mass": false,
      "permitted_package_range_midpoint_used": false
    }
  }
}
